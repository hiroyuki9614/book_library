generator client {
  provider = "prisma-client"
  output   = "./generated/prisma/"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../docs/ER図.svg"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  email         String        @unique @db.VarChar(254)
  emailVerified Boolean       @default(false) @map("email_verified")
  name          String        @db.VarChar(255)
  image         String?       @db.VarChar(2048)
  roleId        Int           @map("role_id")
  deletedAt     DateTime?     @map("deleted_at")
  accounts      Account[]
  readingInfos  ReadingInfo[]
  role          Role          @relation(fields: [roleId], references: [id])
  sessions      Session[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime @map("expires_at")
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(255)
  userId                Int       @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Role {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  name                String               @unique @db.VarChar(255)
  roleBookPermissions RoleBookPermission[]
  users               User[]

  @@map("roles")
}

model Book {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  title               String               @db.VarChar(255)
  authorName          String?              @map("author_name") @db.VarChar(255)
  publishedAt         DateTime?            @map("published_at") @db.Date
  publisher           String?              @db.VarChar(255)
  description         String?
  deletedAt           DateTime?            @map("deleted_at")
  categoryId          Int                  @map("category_id")
  pageTurnDirection   String               @default("ltr") @map("page_turn_direction") @db.VarChar(50)
  bookFiles           BookFile[]
  category            Category             @relation(fields: [categoryId], references: [id])
  readingInfos        ReadingInfo[]
  roleBookPermissions RoleBookPermission[]

  @@index([title, authorName])
  @@map("books")
}

model Category {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  name         String   @unique @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  books        Book[]

  @@map("categories")
}

model BookFile {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  extension        String   @db.VarChar(10)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  fileUrl          String   @map("file_url") @db.VarChar(2048)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  storedFileName   String   @map("stored_file_name") @db.VarChar(255)
  fileSize         Int      @map("file_size")
  fileHash         String   @unique @map("file_hash") @db.VarChar(64)
  bookId           Int      @map("book_id")
  book             Book     @relation(fields: [bookId], references: [id])

  @@index([bookId])
  @@map("book_files")
}

model ReadingInfo {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  currentPosition String?  @map("current_position") @db.VarChar(255)
  readStatus      String   @default("unread") @map("read_status") @db.VarChar(50)
  userId          Int      @map("user_id")
  bookId          Int      @map("book_id")
  book            Book     @relation(fields: [bookId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_infos")
}

model RoleBookPermission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  bookId    Int      @map("book_id")
  roleId    Int      @map("role_id")
  book      Book     @relation(fields: [bookId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([roleId, bookId])
  @@index([roleId])
  @@index([bookId])
  @@map("role_book_permissions")
}
