DATABASE_URL="postgresql://postgres:<set-a-local-password>@localhost:5432/book_library"
APP_PORT=3000
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"

# Storage driver. Keep local for development; use r2 only with server-side credentials.
BOOK_FILE_STORAGE_DRIVER="local"
# Local PDF storage root. BookFile.fileUrl stores an opaque relative storage key.
BOOK_FILE_STORAGE_ROOT="./storage"
# R2 S3-compatible settings. Names only; never commit real values.
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="<private-bucket-name>"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 開発用seedの認証ユーザーを作成する場合だけ、一時的に設定する
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# 初期管理者CLIで必須。実値はローカル環境へ安全に設定し、コミットしない
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
