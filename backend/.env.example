DATABASE_URL="postgresql://postgres:<set-a-local-password>@localhost:5432/book_library"
APP_PORT=3000
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"

# Local development/E2E storage root. R2 production does not use this path.
BOOK_FILE_STORAGE_ROOT="./storage"

# Book file storage. Use local for development/E2E and r2 in production.
BOOK_FILE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override. Normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

# 開発用seedの認証ユーザーを作成する場合だけ、一時的に設定する
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# 初期管理者CLIで必須。実値はローカル環境へ安全に設定し、コミットしない
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
