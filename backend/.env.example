DATABASE_URL="postgresql://postgres:<set-a-local-password>@localhost:5432/book_library"
APP_PORT=3000
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"

# Phase 3 local PDF storage root. BookFile.fileUrl stores a relative key under this directory.
BOOK_FILE_STORAGE_ROOT="./storage"

# 開発用seedの認証ユーザーを作成する場合だけ、一時的に設定する
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

# 初期管理者CLIで必須。実値はローカル環境へ安全に設定し、コミットしない
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
