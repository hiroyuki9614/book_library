# Non-secret deployment configuration. Replace every placeholder before use.
POSTGRES_USER=belib
POSTGRES_PASSWORD=REPLACE_WITH_OPERATOR_SECRET
POSTGRES_DB=belib
ENVIRONMENT=production
FRONTEND_URL=https://REPLACE_WITH_OPERATOR_ORIGIN
BETTER_AUTH_URL=https://REPLACE_WITH_OPERATOR_ORIGIN
BETTER_AUTH_SECRET=REPLACE_WITH_OPERATOR_SECRET
# Browser-visible and authentication origins are operator-supplied. Do not use loopback values for remote Production clients.
VITE_API_BASE_URL=https://REPLACE_WITH_OPERATOR_ORIGIN
BOOK_FILE_STORAGE_DRIVER=r2
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_OPERATOR_SECRET
R2_BUCKET_NAME=REPLACE_WITH_PRIVATE_R2_BUCKET
# Optional override; normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
