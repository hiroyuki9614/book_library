VITE_API_BASE_URL=http://localhost:3000

# Browser-visible, intentionally public login credentials for the limited demo user.
# Never reuse private/operator credentials; set both or neither.
VITE_PUBLIC_DEMO_EMAIL=
VITE_PUBLIC_DEMO_PASSWORD=

# A newly provisioned administrator explicitly approved for public demo use.
# This grants full administrator access. Never reuse a private/operator account.
VITE_PUBLIC_DEMO_ADMIN_EMAIL=
VITE_PUBLIC_DEMO_ADMIN_PASSWORD=
