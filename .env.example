# Local development values only. Never commit real credentials.
POSTGRES_USER=user
POSTGRES_PASSWORD=<set-a-local-password>
POSTGRES_DB=app_db
DATABASE_URL=postgresql://user:<set-a-local-password>@localhost:5432/app_db?schema=public
BETTER_AUTH_SECRET=

# Optional development seed credentials. Keep values local and uncommitted.
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Required only for Playwright E2E. The database name must end in _e2e.
E2E_ADMIN_EMAIL=
E2E_ADMIN_NAME=
E2E_ADMIN_PASSWORD=
E2E_DATABASE_URL=postgresql://user:<set-a-local-password>@localhost:5432/booklib_e2e
E2E_MVP_PASSWORD=
# E2E fixture paths must be absolute or otherwise valid from the E2E startup process.
E2E_BOOK_FILE_STORAGE_ROOT=
E2E_MVP_METADATA_PATH=

# Book file storage. Use local for development/E2E and r2 in production.
BOOK_FILE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional override. Normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
